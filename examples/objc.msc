extern class NSMutableArray {
    # This is translated to a wrapper function that does this:
    #   sel = sel_registerName("alloc");
    #   cls = objc_getClass("NSMutableArray");
    #   return objc_msgSend(cls, sel);
    #
    # The &+\ is a mutable, reference-counted, objective reference
    extern fn alloc() -> &+\instancetype @static @allocates;

    extern fn arrayWithCapacity(:uptr) -> &+\instancetype @static @allocates;

    # This is translated to a wrapper function that does this:
    #   sel = sel_registerName("init:");
    #   cls = objc_getClass("NSMutableArray");
    #   return objc_msgSend(cls, sel);
    extern fn init(&+\instancetype) -> &+\instancetype;
    extern fn initWithCapacity(&+\instancetype, :uptr) -> &+\instancetype;

    # You can make the wrapper function have a different name than the objc one
    # it invokes
    # Make sure not to name parameters unless the Objective-C selector has them
    # named (the selector this invokes is "addObject:" (the first argument is
    # interpreted as self due to the lack of @static)
    extern fn add(&+\instancetype, :&+\id) -> void @alias("addObject");

    # Since this has a named parameter, the selector is "insertObject:atIndex:"
    extern fn insert(&+\instancetype, :&+\id, atIndex: uptr) -> void @alias("insertObject");

    extern fn remove(&+\instancetype, :uptr) -> void @alias("removeObjectAtIndex");

    # Since this has a named parameter, the selector is "replaceObjectAtIndex:withObject:"
    extern fn replace(
        &+\instancetype,
        :uptr,
        withObject: &+\id
    ) -> void @alias("replaceObjectAtIndex");

    extern fn exchange(
        &+\instancetype,
        :uptr, # Unlike functions we do not need to define a parameter name so
               # when the argument label isn't present there is nothing before
               # the colon
        withObjectAtIndex: uptr,
    ) -> void @alias("exchangeObjectAtIndex");
}

