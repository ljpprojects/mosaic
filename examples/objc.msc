# You can also have Mosaic talk to Objective-C
# This means that I will also have to implement a binding generator from Mosaic
# to Objective-C

extern interface @objc NSObject {
    # You would declare external ivars here
    # extern let isa: &+\class;
    # We won't declare the isa ivar as you shouldn't use it directly

    extern fn init(&+\instancetype) -> &+\instancetype;
}

# To declare external protocols use `extern interface @objc @protocol`

# An @objc interface without an implementation becomes a protocol
# The set fo runtime functions to define the protocol can be executed using the
# `setup protocol` statement before any hand-off to Objective-C.
interface @objc MscProtocol {
    # u64 becomes uint64_t
    fn almanop(self: &+\instancetype) -> u64;
    fn ponamla(from: u64) -> &+\instancetype;
}

# Classes are very similar to normal interfaces in syntax
# They also define a set of function calls to setup the class for Objective-C
# use (which must be executed with `setup class` before any handoff to
# Objective-C can happen, it is your job to handle that)
#
# Unlike normal interfaces, they can inherit from one superclass and many
# protocols (in the angle brackets)
interface @objc MscData : NSObject <MscProtocol> {
    # These are transformed into ivars with names of _x and _y
    # let means no setter is synthesised
    # uptr becomes NSUInteger
    let x @public: uptr;
    let y @public: uptr;

    fn data(
        x: uptr,
        y y: uptr # The first y is the argument label, the second is the parameter
                  # name. Very similar to Swift. All functions can have labelled
                  # arguments, not just class methods. UNLIKE Swift the labels
                  # are optional at the call site
    ) -> &+\instancetype @static @allocates;

    # Since this function isn't marked static self is treated as a parameter name
    # for the instance and won't appear in the selector
    fn initWithParams(
        self: &+\instancetype, # Objective references can alias even when mutable
                               # but @take plays better with the semantics of
                               # init (don't retain, aliasing would retain it)
        x: uptr,
        y y: uptr
    ) -> &+\instancetype;
}

impl MscData {
    # This generates the getters 'x' and 'y' (but NOT setters)
    synthesise let x;
    synthesise let y;

    # The Objective-C selector for this function would be "data:y:"
    fn dataWithParams(
        x: uptr,
        y y: uptr
    ) -> &+\instancetype @static @allocates = instancetype::alloc().init();

    # Reasonable default implementation
    fn NSObject::init(self: &+\instancetype @take) -> &+\instancetype {
        self = super.init();
        self._x = uptr<0>;
        self._y = uptr<0>;
        return self;
    }

    # The selector for this would be "initWithParams:y:"
    fn initWithParams(
        self: &+\instancetype @take,
        x: uptr,
        y y: uptr
    ) -> &+\instancetype {
        # This compiles down to getting the super class and objc_msgSendSuper
        # with the "init" selector
        self = super.init();
        self._x = x;
        self._y = y;
        return self;
    }

    fn <MscProtocol>::almanop(self: &+\instancetype) -> u64 = self._x + self._y;
    fn <MscProtocol>::ponamla(from: u64) -> &+\instancetype
        = instancetype::dataWithParams(from / 2, y: from / 2);
}

fn main -> i32 {
    # Call Objective-C runtime methods to setup our MscData class;
    setup class MscData;
    setup protocol MscProtocol;

    # This inbvokes the compiler generated wrapper for [NSMutableArray arrayWithCapacity:]
    let arr: &+\NSMutableArray =
        NSMutableArray::arrayWithCapacity(uptr<3>);

    # Since arr is tracked by MSR, and is marked as Objective, at the end of
    # this region it calls release on it

    # Since we did not define any wrappers for NSNumber we must revert to manual
    # message sending
    arr.add(objc::msgSend(NSNumber, "numberWithUnsignedInteger:", uptr<1997>));
    arr.add(objc::msgSend(NSNumber, "numberWithUnsignedInteger:", uptr<1984>));
    arr.add(objc::msgSend(NSNumber, "numberWithUnsignedInteger:", uptr<1901>));

    return 0;
}

# About Mosaic to Objective-C binding generation
# Perhaps the CLI will be `msc2objc` and it is invoked like this??
#   `msc2objc -CF file-with-classes.msc -o file-with-classes.h`
# Where `-C` is to generate headers for classes
# And maybe `-F` could be specified to generate function bindings

# What if Mosaic just... unzeroed out .bss

# You can declare a function @objc for Objc binding generation to generate a
# binding for it, but that's all it changes
function lmnop -> &+\MscData @objc {
    return MscData::dataWithParams(1997, y: 1984);
}

