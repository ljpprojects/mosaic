# Example of manual reference counting
# Use --nomsr to compile

import core::rc;
import std::fmt;

# The Ref interface is like the Objective-C NSObject
interface Person : rc::RefCounted, fmt::Format {
    # @strong indicates that the compiler should retain the new reference in the
    # setter before setting
    let @strong name: &String;
    let @strong surname: &String;

    fn init(name: &String, surname: &String) -> &Person @required;
};

impl Person {
    synthesise let name;
    synthesise let surname;

    # By default references to a Ref type are strong. For weak references use @weak (even in MRC)
    fn init(name: &String, surname: &String) -> &Person {
        # RefCounted::alloc allocates a reference of Self with a refcount of 1
        # Person uses the default RefCounted implementation unless overriden
        let self: &Person = Person::alloc();

        # The compiler would do something like this in the synthesises setters
        self._name = name.retain();
        self._surname = surname.retain();

        return self;
    }

    # Provide an implementation of Format::format
    fn Format::format(self: &Person, formatter: fmt::Formatter) -> void {
        formatter.append("\{self.name} \{self.surname}");
    }

    # Override the implementation of Ref::drop
    # Equivalent to `synthesise RefCounted::drop;`, generally the compiler can
    # generate this for you
    fn RefCounted::drop(self: &Person) -> void {
        self._name.release();
        self._surname.release();
        self.dealloc();
    }
}
