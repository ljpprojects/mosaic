# Ripped from my implementation of the stdlib

include devcore::mem;
include devstd::string
include devstd::bytes
# include devcore::trace

extern fn exit(code: i32) -> null
extern fn puts(string: CString) -> null
extern fn write(fd: i32, buf: RawByteArray, len: i32) -> i32
extern fn memset(dest: AnyPtrMut, value: i32, count: i32) -> AnyPtrMut

data Stream {
    let fd: i32
    mut readonly: bool
}

type Stream = data Stream;
type MaybeStream = *mut? Stream;

fn MaybeStream::unwrap(self: MaybeStream) export -> Stream {
    return guard self else {
        exit(1)

        return (0 as i64) as MaybeStream
    }
}

fn MaybeStream::null export -> MaybeStream {
    return (0 as i64) as MaybeStream
}

fn Stream::new export alloc -> MaybeStream {
    let self = guard alloc(sizeof Stream) else {
        return MaybeStream::null()
    }

    return self as MaybeStream
}

fn Stream::deinit(self: Stream) export dealloc -> null {
    return free(self)
}

fn Stream::stdout export alloc -> MaybeStream {
    let size = sizeof Stream;

    let ptr = guard alloc(size) else {
        return (0 as i64) as MaybeStream
    };

    let self = (ptr as Stream);

    let fd = 1;

    # self.fd = fd;

    memcpy((&self.fd) as *mut any, (&fd) as *const any, 4);

    return (self as *mut any) as MaybeStream
}

fn Stream::stdin export alloc -> MaybeStream {
    let size = sizeof Stream;

    let ptr = guard alloc(size) else {
        return (0 as i64) as MaybeStream
    };

    let self = (ptr as Stream);

    let fd = 2;

    memcpy((&self.fd) as *mut any, (&fd) as *const any, 4);
    memset((&self.readonly) as *mut any, 1, 1);

    return (self as *mut any) as MaybeStream
}

fn Stream::write(self: Stream, bytes: ByteArray) export -> null {
    write(self.fd, bytes.as_ptr(), bytes.length());

    return null
}

fn Stream::read(self: Stream, dest: ByteArray) export -> null {
    # read(self.fd, bytes.as_ptr(), bytes.length());

    return null
}

