# Ripped from my implementation of the stdlib

include devcore::mem;

type ByteArray = *const [i8];
type ByteArrayMut = *mut [i8];
type MaybeByteArrayMut = *mut? [i8];

type RawByteArray = *const i8;
type RawByteArrayMut = *mut i8;

fn ByteArrayMut::with_length(length: i32) export ->  MaybeByteArrayMut {
    let maybe_null = alloc(4 + length);

    let ptr = guard maybe_null else {
        return (0 as i64) as MaybeByteArrayMut
    }

    return ptr as MaybeByteArrayMut
}

fn ByteArray::length(self: ByteArray) export -> i32 {
    return (*(self as *const i32))
}

fn ByteArrayMut::length(self: ByteArrayMut) export -> i32 {
    return (*(self as *const i32))
}

fn ByteArray::as_ptr(self: ByteArray) export -> RawByteArray {
    return (self + 4 as i64) as RawByteArray
}

fn ByteArrayMut::as_ptr(self: ByteArrayMut) export -> RawByteArray {
    return (self + 4 as i64) as RawByteArray
}

fn ByteArrayMut::as_ptr_mut(self: ByteArrayMut) export -> RawByteArrayMut {
    return (self + 4 as i64) as RawByteArrayMut
}
