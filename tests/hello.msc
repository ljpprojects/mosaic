# Fancy hello world example, but std::io is just fancy abstraction of read/write syscalls

include std::string
include std::io
include std::bytes

extern fn memcpy(dest: *mut any, src: *const any, len: usize) -> null;

fn main -> i32 {
    let message_str: Str = "Hello, World!!!!!!!!!!!!!!!!\n" as Str;
    let message_bytes: ByteArrayMut = ByteArrayMut::with_length(message_str.length() as usize - 1 as usize);
    message_bytes.copy_from(message_str as ByteArray);

    let stdout = Stream::stdout();

    mut i = 0;

    while i < 1000000 {
        stdout.write(message_bytes as ByteArray);

        i = i + 1
    }

    message_bytes.deinit();

    return 0
}
