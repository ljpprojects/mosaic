# Simple map implementation ported from C into Mosaic

include std::io
include std::string

data _StrDictNode {
  key: String,
  value: String
};

/// A map that has strings as the keys and values
typedef struct {
  StrDictNode *root;
} StrDict;

fn main -> i32 {
    let string = "Hello, World!\n" as *const [i8];

    let maybe_stdout: MaybeStream = (guard Stream::stdout() else {
        return 1
    });

    let stdout = maybe_stdout.unwrap();
    mut counter = 0;

    while counter < 5 {
        stdout.write(string as ByteArray)

        counter = counter + 1
    };

    stdout.deinit()

    return 0
}
