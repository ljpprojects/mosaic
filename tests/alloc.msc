# Showcase the core::mem usage

include core::mem; # cwd must be tests for this to be resolved, or it must be installed system-wide (see install.sh)

extern fn puts(c: *const i8) -> null; # Print to stdout without using std, usually you would use std

fn main export -> i32 {
    puts("Allocating memory...\0");

    # Allocate a pointer
    # Allocated memory is zeroed always
    let m_ptr: MaybeAnyPtrMut = alloc(4 as usize);

    # Use the guard clause to exit if it is null (and cast it to a usable AnyPtrMut, which cannot be done with the 'as' operator)
    let ptr: AnyPtrMut = guard m_ptr else {
        puts("OOM?\0");

        return 1 # The parser does not like it if you give the last statement in a block a semicolon, so DON'T!
    };

    # Use defer to free the pointer at the end of the function (before return)
    defer {
        puts("Freeing memory...\0"); # Null terminator is explicit, the default type for strings is an array, which stores length information at compile time only
        ptr.dealloc()
    }

    # Now we can use the pointer
    # We will use it to point to a i32

    let num_ptr: *mut i32 = ptr as *mut i32; # The cast here is implicit

    while (*num_ptr) < 5 {
        puts(".\0" as *const i8);
        (*num_ptr) = (*num_ptr) + 1
    }

    return 0
}
